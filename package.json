{
  "name": "identizen",
  "version": "0.0.0",
  "private": true,
  "description": "Identizen — open-source, device-based identity. Login with your phone.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "db",
    "e2e",
    "e2e/site"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test:unit",
    "e2e": "turbo run e2e",
    "gate": "npm run lint && npm run typecheck && npm run test:unit && npm run e2e && npm run audit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=./packages/* && changeset publish",
    "audit": "npm audit --omit=dev --audit-level=critical",
    "sbom": "npm sbom --sbom-format=cyclonedx --omit=dev > sbom.cdx.json"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "npm@10.9.8",
  "type": "module",
  "overrides": {
    "react-native-css-interop": {
      "lightningcss": "1.32.0"
    }
  }
}
