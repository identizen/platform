{
  "expo": {
    "name": "Identizen",
    "slug": "identizen",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "identizen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbfbfc"
    },
    "ios": {
      "bundleIdentifier": "com.identizen.app",
      "supportsTablet": false,
      "associatedDomains": ["applinks:app.identizen.com"],
      "infoPlist": {
        "NSFaceIDUsageDescription": "Identizen uses Face ID to approve sign-ins with your identity.",
        "NSCameraUsageDescription": "Identizen uses the camera to scan sign-in QR codes."
      }
    },
    "android": {
      "package": "com.identizen.app",
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#fbfbfc" },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "app.identizen.com", "pathPrefix": "/l/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-status-bar",
      "expo-splash-screen",
      [
        "expo-local-authentication",
        { "faceIDPermission": "Identizen uses Face ID to approve sign-ins with your identity." }
      ],
      [
        "expo-camera",
        { "cameraPermission": "Identizen uses the camera to scan sign-in QR codes." }
      ],
      ["expo-notifications", { "icon": "./assets/icon.png", "color": "#3b5bdb" }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
