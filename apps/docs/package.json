{
  "name": "@identizen/docs",
  "version": "0.0.0",
  "private": true,
  "description": "docs.identizen.com — Astro Starlight.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "sync-spec": "tsx scripts/sync-spec.ts",
    "predev": "npm run sync-spec",
    "dev": "astro dev --port 4330",
