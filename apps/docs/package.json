    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.10.2",
    "@identizen/protocol": "^0.1.0",
    "@identizen/react": "^0.1.0",
    "@identizen/sdk": "^0.1.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/express": "^5.0.6",
    "@types/react": "^19.1.10",
    "express": "^5.1.0",
    "jose": "^6.0.13",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "unist-util-visit": "^5.1.0"
  }
