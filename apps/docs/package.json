    "build": "astro build",
    "preview": "astro preview --port 4331",
    "typecheck": "npm run sync-spec && astro check",
    "docs:verify": "npm run sync-spec && tsx scripts/verify-samples.ts",
    "test:unit": "npm run docs:verify",
    "e2e": "playwright test",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.36.3",
    "@identizen/ui": "^0.0.0",
    "astro": "^5.18.2"
  },
