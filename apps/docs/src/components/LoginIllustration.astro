---
/**
 * Compact product illustration: a browser card with "Continue with Identizen" and the match code,
 * a phone showing the approve screen with the same code, joined by the challenge → approval flow.
 * Pure inline SVG on token colours, so it follows light/dark automatically.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class:list={['login-illustration', className]}
  viewBox="0 0 520 340"
  width="520"
  height="340"
  role="img"
  aria-labelledby="login-illustration-title"
  fill="none"
>
  <title id="login-illustration-title"
    >A browser showing a Continue with Identizen button and match code 47, connected to a phone
    showing the same code and an approve prompt</title
  >
  <defs>
    <linearGradient id="il-flow" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="var(--color-accent)" stop-opacity="0.15"></stop>
      <stop offset="0.5" stop-color="var(--color-accent)"></stop>
      <stop offset="1" stop-color="var(--color-accent)" stop-opacity="0.15"></stop>
    </linearGradient>
    <radialGradient id="il-glow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="var(--color-accent)" stop-opacity="0.18"></stop>
      <stop offset="1" stop-color="var(--color-accent)" stop-opacity="0"></stop>
    </radialGradient>
    <filter id="il-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#000" flood-opacity="0.12"
      ></feDropShadow>
    </filter>
    <pattern id="il-qr" width="6" height="6" patternUnits="userSpaceOnUse">
      <rect width="3" height="3" fill="var(--color-fg)"></rect>
      <rect x="3" y="3" width="3" height="3" fill="var(--color-fg)"></rect>
    </pattern>
  </defs>

  <!-- backdrop glow -->
  <ellipse cx="260" cy="180" rx="250" ry="150" fill="url(#il-glow)"></ellipse>

  <!-- browser card -->
  <g filter="url(#il-shadow)">
    <rect x="18" y="46" width="288" height="204" rx="14" fill="var(--color-surface-0)" stroke="var(--color-border)"
    ></rect>
  </g>
  <rect x="18" y="46" width="288" height="34" rx="14" fill="var(--color-surface-1)"></rect>
  <rect x="18" y="66" width="288" height="14" fill="var(--color-surface-1)"></rect>
  <line x1="18" y1="80" x2="306" y2="80" stroke="var(--color-border)"></line>
  <circle cx="38" cy="63" r="4" fill="var(--color-danger)" opacity="0.75"></circle>
  <circle cx="52" cy="63" r="4" fill="var(--color-warning)" opacity="0.75"></circle>
  <circle cx="66" cy="63" r="4" fill="var(--color-success)" opacity="0.75"></circle>
  <rect x="86" y="55" width="180" height="16" rx="8" fill="var(--color-surface-2)"></rect>
  <text x="98" y="66.5" font-family="var(--font-mono)" font-size="9" fill="var(--color-fg-muted)"
    >acme.com/login</text
  >

  <text x="42" y="112" font-family="var(--font-sans)" font-size="13" font-weight="600" fill="var(--color-fg)"
    >Sign in to Acme</text
  >
  <text x="42" y="130" font-family="var(--font-sans)" font-size="10" fill="var(--color-fg-muted)"
    >No password. Approve on your phone.</text
  >
  <rect x="42" y="146" width="152" height="30" rx="8" fill="var(--color-accent)"></rect>
  <text x="118" y="165" text-anchor="middle" font-family="var(--font-sans)" font-size="10.5" font-weight="600" fill="var(--color-accent-fg)"
    >Continue with Identizen</text
  >
  <text x="42" y="200" font-family="var(--font-sans)" font-size="9" fill="var(--color-fg-muted)"
    >Match code</text
  >
  <text x="42" y="228" font-family="var(--font-mono)" font-size="26" font-weight="600" letter-spacing="2" fill="var(--color-fg)"
    >47</text
  >
  <!-- QR -->
  <rect x="216" y="112" width="64" height="64" rx="6" fill="var(--color-surface-0)" stroke="var(--color-border)"
  ></rect>
  <rect x="222" y="118" width="52" height="52" fill="url(#il-qr)" opacity="0.85"></rect>
  <rect x="222" y="118" width="14" height="14" fill="var(--color-fg)"></rect>
  <rect x="260" y="118" width="14" height="14" fill="var(--color-fg)"></rect>
  <rect x="222" y="156" width="14" height="14" fill="var(--color-fg)"></rect>
  <rect x="226" y="122" width="6" height="6" fill="var(--color-surface-0)"></rect>
  <rect x="264" y="122" width="6" height="6" fill="var(--color-surface-0)"></rect>
  <rect x="226" y="160" width="6" height="6" fill="var(--color-surface-0)"></rect>

  <!-- flow line browser -> phone -->
  <path
    class="il-flow"
    d="M306 150 C 340 150, 340 190, 372 190"
    stroke="url(#il-flow)"
    stroke-width="2"
    stroke-dasharray="6 6"
    stroke-linecap="round"></path>
  <text x="318" y="140" font-family="var(--font-mono)" font-size="8" fill="var(--color-fg-muted)"
    >challenge</text
  >
  <path
    class="il-flow il-flow-back"
    d="M372 214 C 340 214, 340 250, 306 250"
    stroke="url(#il-flow)"
    stroke-width="2"
    stroke-dasharray="6 6"
    stroke-linecap="round"></path>
  <text x="312" y="268" font-family="var(--font-mono)" font-size="8" fill="var(--color-fg-muted)"
    >signed</text
  >

  <!-- phone -->
  <g filter="url(#il-shadow)">
    <rect x="372" y="34" width="128" height="272" rx="24" fill="var(--color-fg)" opacity="0.92"
    ></rect>
  </g>
  <rect x="378" y="40" width="116" height="260" rx="20" fill="var(--color-surface-0)"></rect>
  <rect x="418" y="46" width="36" height="8" rx="4" fill="var(--color-fg)" opacity="0.9"></rect>
  <text x="436" y="86" text-anchor="middle" font-family="var(--font-sans)" font-size="9" fill="var(--color-fg-muted)"
    >Sign in to</text
  >
  <text x="436" y="102" text-anchor="middle" font-family="var(--font-sans)" font-size="13" font-weight="600" fill="var(--color-fg)"
    >Acme</text
  >
  <text x="436" y="128" text-anchor="middle" font-family="var(--font-sans)" font-size="8.5" fill="var(--color-fg-muted)"
    >Match code</text
  >
  <rect x="404" y="136" width="64" height="44" rx="10" fill="var(--color-accent-soft)"></rect>
  <text x="436" y="166" text-anchor="middle" font-family="var(--font-mono)" font-size="24" font-weight="600" letter-spacing="2" fill="var(--color-accent-soft-fg)"
    >47</text
  >
  <!-- face id glyph -->
  <g stroke="var(--color-fg)" stroke-width="2" stroke-linecap="round" fill="none" transform="translate(422 198)">
    <path d="M0 6 V2 a2 2 0 0 1 2-2 h4"></path>
    <path d="M28 6 V2 a2 2 0 0 0-2-2 h-4"></path>
    <path d="M0 22 v4 a2 2 0 0 0 2 2 h4"></path>
    <path d="M28 22 v4 a2 2 0 0 1-2 2 h-4"></path>
    <path d="M9 11 v1"></path>
    <path d="M19 11 v1"></path>
    <path d="M14 11 v6 h-2"></path>
    <path d="M10 20 q4 3 8 0"></path>
  </g>
  <rect x="392" y="244" width="88" height="26" rx="8" fill="var(--color-accent)"></rect>
  <text x="436" y="261" text-anchor="middle" font-family="var(--font-sans)" font-size="10" font-weight="600" fill="var(--color-accent-fg)"
    >Approve</text
  >
  <text x="436" y="286" text-anchor="middle" font-family="var(--font-sans)" font-size="9" fill="var(--color-fg-muted)"
    >Deny</text
  >
</svg>

<style>
  .login-illustration {
    width: 100%;
    height: auto;
    max-width: 520px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .il-flow {
      animation: il-dash 2.4s linear infinite;
    }
    .il-flow-back {
      animation-direction: reverse;
    }
    @keyframes il-dash {
      to {
        stroke-dashoffset: -24;
      }
    }
  }
</style>
