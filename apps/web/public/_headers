# Apple fetches the association file without an extension and requires JSON.
/.well-known/apple-app-site-association
  Content-Type: application/json

# Over-the-air install manifest for internal iOS builds (see apps/mobile/scripts/install-manifest.mjs).
/install.plist
  Content-Type: application/xml
  Cache-Control: no-store

# Android reads the app-links statement and requires JSON.
/.well-known/assetlinks.json
  Content-Type: application/json
