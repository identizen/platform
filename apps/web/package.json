{
  "name": "@identizen/web",
  "version": "0.0.0",
  "private": true,
  "description": "app.identizen.com — installable PWA dashboard: devices, paired browsers, sessions, activity, handle.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4300 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4301 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@identizen/dashboard": "^0.3.1",
    "@identizen/ui": "^0.1.0",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-router": "^1.131.30",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "msw": "^2.10.5",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
