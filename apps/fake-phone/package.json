{
  "name": "@identizen/fake-phone",
  "version": "0.0.0",
  "private": true,
  "description": "A scriptable Identizen phone for local development and e2e: registers a device + identity, receives challenges, and approves, denies, or ignores them per policy.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "identizen-fake-phone": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@identizen/protocol": "^0.1.0",
    "hono": "^4.9.4"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
