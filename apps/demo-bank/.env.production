# Baked into the bundle by `vite build`. Both values are public: the hosted index and the
# demo bank's public PKCE client id, registered with `POST /sites` (see /docs/register).
VITE_IDENTIZEN_INDEX_URL=https://index.identizen.com
VITE_IDENTIZEN_CLIENT_ID=idz_live_01M1M3G92MD1J0GQDRK9F5SB2W

# Fromenance verify page (/verify). The site key is public and bound to jtmerlin.com, www, the
# workers.dev fallback, and localhost:4500/4501 on the tenant. Turnstile is optional: the widget
# only loads it when the API answers 428 (site key over its normal rate). Fill it from the
# Cloudflare Turnstile widget "Fromenance verify", which already lists jtmerlin.com.
VITE_FROMENANCE_SITE_KEY=sk_pub_ba5ca4a4b3a5cea18dc7c1b01ba937d0
VITE_FROMENANCE_TURNSTILE_SITE_KEY=
