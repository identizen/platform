{
  "name": "@identizen/demo-bank",
  "version": "0.0.0",
  "private": true,
  "description": "JT Merlin Bank: a fictional bank that shows how a site integrates Identizen for login and transaction approval.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4500 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4501 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@identizen/react": "^0.1.0",
    "@identizen/sdk": "^0.1.0",
    "@identizen/ui": "^0.0.0",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-router": "^1.131.30",
    "lucide-react": "^0.540.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  }
}
