{
  "name": "@identizen/index",
  "version": "0.4.3",
  "private": false,
  "description": "Identizen index / relay / OIDC provider for Cloudflare Workers, as a deployable Worker and an embeddable library.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "openapi": "tsx scripts/gen-openapi.ts",
    "predev": "npm run openapi",
    "dev": "wrangler dev --env dev",
    "prebuild": "npm run openapi",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run openapi",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest:unit": "npm run openapi",
    "test:unit": "vitest run --exclude \"test/oidc-conformance-*\" && vitest run test/oidc-conformance-discovery.test.ts test/oidc-conformance-authorize.test.ts test/oidc-conformance-token.test.ts",
    "predeploy": "npm run openapi",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "keys": "tsx scripts/gen-oidc-keys.ts",
    "dev:e2e": "wrangler dev --env e2e"
  },
  "dependencies": {
    "@identizen/db": "^0.1.0",
    "@identizen/protocol": "^0.2.0",
    "hono": "^4.9.4",
    "jose": "^6.0.13",
    "qrcode-generator": "^1.5.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.60",
    "@cloudflare/workers-types": "^4.20250906.0",
    "@readme/openapi-parser": "^9.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0",
    "yaml": "^2.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/plsft/identizen.git",
    "directory": "apps/index"
  }
}
