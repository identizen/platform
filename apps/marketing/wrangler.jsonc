{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "identizen-marketing",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "PUBLIC_IDENTIZEN_INDEX_URL": "https://index.identizen.com",
    "CONTACT_TO": "hello@identizen.com",
  },
  "routes": [
    {
      "pattern": "identizen.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.identizen.com",
      "custom_domain": true,
    },
  ],
}
