{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "types": ["astro/client"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "*.ts"],
  "exclude": ["dist"]
}
