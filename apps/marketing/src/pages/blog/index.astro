---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = new Intl.DateTimeFormat('en', { dateStyle: 'long' });
---

<Base
  title="Blog"
  description="Notes from building Identizen: protocol decisions, product thinking, and what we learned shipping device-based identity."
>
  <header class="max-w-2xl">
    <h1 class="text-4xl font-semibold tracking-tight">Blog</h1>
    <p class="mt-4 text-lg text-fg-muted">Protocol decisions, product thinking, release notes.</p>
  </header>
  <ul class="mt-10 divide-y divide-border">
    {
      posts.map((post) => (
        <li class="py-6">
          <a href={`/blog/${post.id}`} class="group block">
            <time
              datetime={post.data.date.toISOString()}
              class="font-mono text-2xs uppercase tracking-wide text-fg-muted"
            >
              {fmt.format(post.data.date)}
            </time>
            <h2 class="mt-1 text-xl font-semibold group-hover:underline underline-offset-4">
              {post.data.title}
            </h2>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-fg-muted">
              {post.data.description}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
