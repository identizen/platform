---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" noindex>
  <div class="mx-auto max-w-xl py-20 text-center">
    <p class="font-mono text-2xs uppercase tracking-wide text-fg-muted">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">That page is not in the index.</h1>
    <p class="mt-4 text-fg-muted">
      Try the <a href="/" class="text-accent underline underline-offset-2">home page</a> or the <a
        href="https://docs.identizen.com"
        class="text-accent underline underline-offset-2">docs</a
      >.
    </p>
  </div>
</Base>
