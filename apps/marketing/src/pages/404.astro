---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site';
---

<Base title="Not found" noindex>
  <section class="bg-glow relative overflow-hidden">
    <div class="bg-dots absolute inset-0" aria-hidden="true"></div>
    <div class="container-site relative max-w-xl py-28 text-center sm:py-40">
      <p class="eyebrow justify-center">404</p>
      <h1 class="headline mt-3 text-4xl sm:text-5xl">That page is not in the index.</h1>
      <p class="mt-5 text-lg text-fg-muted">
        Nothing signed for this address. Try the home page or the docs.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="btn btn-primary">Home <Icon name="arrow-right" /></a>
        <a href={SITE.docs} class="btn btn-secondary">Docs</a>
      </div>
    </div>
  </section>
</Base>
