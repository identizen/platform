---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons';
import { SITE } from '../lib/site';

const beliefs: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'smartphone',
    title: 'The phone is the identity.',
    text: 'The key pair on the device is the user. It is never a code generator or a companion to something else.',
  },
  {
    icon: 'book',
    title: 'The index is a phonebook, not a vault.',
    text: 'Anything we host must be safe to leak.',
  },
  {
    icon: 'globe',
    title: 'Standard on the outside.',
    text: 'Sites see OpenID Connect with PKCE. Nothing proprietary at the integration boundary.',
  },
  {
    icon: 'zap',
    title: 'DX is the product.',
    text: 'If integration takes more than five minutes, it is a bug.',
  },
  {
    icon: 'git-branch',
    title: 'Open core.',
    text: 'The protocol, the index, the SDKs, the CLI, the dashboard and the phone app are Apache-2.0. The layer that runs the index for an organisation is what we sell.',
  },
];
---

<Base
  title="About"
  description="Identizen is built in the open by people who think the phone in your pocket is a better identity provider than a password database or a big-tech account."
>
  <PageHeader
    eyebrow="About"
    title="Identity that belongs to the person holding it."
    lede="We are a small team with a specific complaint: every login on the internet is a shared secret, and every shared secret leaks."
  />

  <section class="container-site pb-16" aria-labelledby="believe">
    <h2 id="believe" class="headline text-3xl">What we believe</h2>
    <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        beliefs.map((b) => (
          <li class="card p-6">
            <span class="icon-tile">
              <Icon name={b.icon} />
            </span>
            <h3 class="mt-5 font-semibold tracking-tight">{b.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">{b.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section border-t border-border bg-surface-1">
    <div class="container-site grid gap-12 lg:grid-cols-2">
      <article class="prose-idz">
        <h2>How the company works</h2>
        <p>
          Identizen the company hosts the public index, the dashboard, and the docs, and sells
          Identizen Enterprise: a dedicated tenant index per organisation in our cloud or on-prem,
          with an admin portal, enrollment and fleet management, login policy, SSO and SCIM, and
          audit export, priced per active device. Professional services cover migrations and custom
          adapters. Identizen is open core: the protocol, the index, the SDKs, the CLI, the
          dashboard and the phone app are one repository under Apache-2.0, the layer that runs the
          index for an organisation is proprietary, and self-hosters of the open index are
          first-class.
        </p>
      </article>
      <article class="prose-idz">
        <h2>Governance</h2>
        <p>
          Benevolent dictator for now; a lightweight RFC process for spec changes once there are
          external implementers, plus a conformance suite so third-party indexes and apps can prove
          interop.
        </p>
        <p>
          <a href={SITE.github} rel="noopener">The code</a> · <a href="/contact">Talk to us</a>
        </p>
      </article>
    </div>
  </section>
</Base>
