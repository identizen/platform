---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { FAQ_GROUPS, FAQS } from '../lib/faq';
import { faqPage, softwareApplication } from '../lib/seo';
import { SITE } from '../lib/site';

const url = new URL('/faq/', Astro.site ?? SITE.url).toString();
const slug = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
---

<Base
  title="FAQ"
  description="Direct answers about Identizen: what it is, how it differs from passkeys and authenticator apps, what a site learns about the user, recovery, security, and pricing."
  jsonLd={[faqPage(url, FAQS), softwareApplication()]}
>
  <PageHeader
    eyebrow="FAQ"
    title="Questions, answered plainly."
    lede="Everything people ask before they add Identizen to a site or install the app. Each answer stands on its own."
  />

  <div class="container-site grid gap-12 pb-24 lg:grid-cols-[220px_1fr]">
    <nav aria-label="FAQ sections" class="hidden lg:block">
      <ul class="sticky top-24 space-y-2 text-sm">
        {
          FAQ_GROUPS.map((g) => (
            <li>
              <a href={`#${slug(g.heading)}`} class="text-fg-muted hover:text-fg">
                {g.heading}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="max-w-3xl">
      {
        FAQ_GROUPS.map((g) => (
          <section aria-labelledby={slug(g.heading)} class="not-first:mt-14">
            <h2 id={slug(g.heading)} class="headline text-2xl sm:text-3xl">
              {g.heading}
            </h2>
            <dl class="mt-6 divide-y divide-border">
              {g.items.map((f) => (
                <div id={slug(f.question)} class="py-6">
                  <dt class="text-lg font-semibold tracking-tight">
                    <a href={`#${slug(f.question)}`} class="hover:text-accent">
                      {f.question}
                    </a>
                  </dt>
                  <dd class="mt-3 leading-relaxed text-fg-muted">{f.answer}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
      <p class="mt-14 border-t border-border pt-6 text-sm text-fg-muted">
        Something missing? <a href="/contact" class="link">Ask us</a>, or read the
        <a href={SITE.docs} class="link" rel="noopener">documentation</a>.
      </p>
    </div>
  </div>
</Base>
