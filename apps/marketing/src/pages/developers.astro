---
import Base from '../layouts/Base.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { SITE } from '../lib/site';

const pathA = `
# Path A — primary login
npx create-next-app@latest my-app && cd my-app
npx identizen init          # register site, write .env.local, scaffold app/api/auth/*
npm install && npm run dev  # open /api/auth/login`;

const pathB = `
// Path B — step-up after your own login
import { createIdentizenServer } from '@identizen/sdk/server';
const idz = createIdentizenServer({ indexUrl, clientId, clientSecret });

// 1. bind once: redirect to idz.authorizationUrl({ ..., prompt: 'enroll' }), store claims.sub
// 2. later, from any backend:
const v = await idz.verify({ sub, reason: 'Approve wire of $12,000 to Acme?' });
const done = await idz.waitForVerification(v.verification_id);
if (done.status === 'approved') { /* the assertion binds the reason hash */ }`;

const claims = [
  ['sub', 'Stable per-site identifier (derived key hash). Two sites cannot correlate a user.'],
  ['sid', 'Session id; back-channel logout revokes by it.'],
  ['acr', 'idz:login (primary) or idz:mfa (step-up).'],
  ['amr', '["face","hwk"], ["fingerprint","hwk"], …'],
  ['idz_device', 'Opaque device id for your own session / device UI.'],
  ['idz_handle', 'Optional human handle, only with the handle scope and only if set.'],
  ['idz_org', 'Org identifier for org identities (enterprise).'],
];

const packages = [
  {
    name: '@identizen/sdk',
    text: 'Browser core (discovery, challenge session, pairing, QR) and server helpers (OIDC exchange, Verification API, webhooks, back-channel logout) for Node, Bun, and Workers.',
  },
  {
    name: '@identizen/react',
    text: '<IdentizenProvider>, <IdentizenButton>, <IdentizenStepUp>, useIdentizen(). Accessible states for code, QR, waiting, approved, denied.',
  },
  {
    name: 'identizen',
    text: 'The CLI. init registers your site and scaffolds routes; dev runs a fake phone; register-site for CI.',
  },
];
---

<Base
  title="Developers"
  description="Integrate Identizen in under five minutes with tools you already know: standard OIDC, a React button, a CLI that scaffolds the callback route."
>
  <header class="max-w-2xl">
    <h1 class="text-4xl font-semibold tracking-tight">Built for the afternoon you have.</h1>
    <p class="mt-4 text-lg text-fg-muted">
      Standard OIDC on the outside. A typed SDK, a React component, and a CLI that does the boring
      parts. If a quickstart step needs explaining, that is a bug we fix.
    </p>
  </header>

  <section aria-labelledby="quick" class="mt-14 grid gap-6 lg:grid-cols-2">
    <h2 id="quick" class="sr-only">Quickstarts</h2>
    <div>
      <h3 class="text-lg font-semibold">Primary login</h3>
      <p class="mt-1 text-sm text-fg-muted">Replace password and social login.</p>
      <CodeBlock code={pathA} lang="sh" title="Path A" class="mt-4" />
    </div>
    <div>
      <h3 class="text-lg font-semibold">MFA and transaction approval</h3>
      <p class="mt-1 text-sm text-fg-muted">Keep your login, add the factor.</p>
      <CodeBlock code={pathB} lang="ts" title="Path B" class="mt-4" />
    </div>
  </section>

  <section aria-labelledby="pk" class="mt-16">
    <h2 id="pk" class="text-2xl font-semibold tracking-tight">Packages</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        packages.map((p) => (
          <li class="rounded-xl border border-border bg-surface-1 p-5">
            <p class="font-mono text-sm font-semibold">{p.name}</p>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">{p.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="claims" class="mt-16">
    <h2 id="claims" class="text-2xl font-semibold tracking-tight">What your site receives</h2>
    <p class="mt-3 max-w-2xl text-fg-muted">
      An <code class="font-mono text-sm">id_token</code> with these claims. No email: if you need one,
      ask the user after login like any app.
    </p>
    <div class="mt-6 overflow-x-auto rounded-xl border border-border">
      <table class="w-full text-sm">
        <thead class="bg-surface-1 text-left text-fg-muted">
          <tr
            ><th scope="col" class="px-4 py-3 font-medium">Claim</th><th
              scope="col"
              class="px-4 py-3 font-medium">Value</th
            ></tr
          >
        </thead>
        <tbody>
          {
            claims.map(([k, v]) => (
              <tr class="border-t border-border">
                <>
                  <th scope="row" class="px-4 py-3 text-left font-mono font-medium">
                    {k}
                  </th>
                  <td class="px-4 py-3 text-fg-muted">{v}</td>
                </>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section
    aria-labelledby="self"
    class="mt-16 grid gap-8 rounded-2xl border border-border bg-surface-1 p-8 sm:grid-cols-2"
  >
    <div>
      <h2 id="self" class="text-2xl font-semibold tracking-tight">Self-host in one command</h2>
      <p class="mt-3 text-fg-muted leading-relaxed">
        The same code runs index.identizen.com. Deploy the index as a Cloudflare Worker with
        Postgres behind Hyperdrive, or run the container. Configuration by environment variables
        only. Federation over WebFinger means your index and ours resolve each other's handles.
      </p>
    </div>
    <div class="flex flex-col justify-center gap-3">
      <a
        href={`${SITE.docs}/self-hosting`}
        class="inline-flex h-11 items-center justify-center rounded-lg bg-accent px-6 font-medium text-accent-fg hover:bg-accent-hover"
        >Self-hosting guide</a
      >
      <a
        href={`${SITE.docs}/protocol/spec`}
        class="inline-flex h-11 items-center justify-center rounded-lg border border-border-strong px-6 font-medium hover:bg-surface-0"
        >Read the protocol spec</a
      >
    </div>
  </section>

  <section class="mt-16 grid gap-4 sm:grid-cols-4">
    {
      [
        ['Quickstart', `${SITE.docs}/quickstart`],
        ['Add MFA', `${SITE.docs}/add-mfa`],
        ['Framework guides', `${SITE.docs}/frameworks/nextjs`],
        ['Verification API', `${SITE.docs}/verification-api`],
      ].map(([label, href]) => (
        <a
          href={href}
          class="rounded-xl border border-border p-5 text-sm font-medium hover:bg-surface-1"
        >
          {label} <span aria-hidden="true">→</span>
        </a>
      ))
    }
  </section>
</Base>
