---
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import Code from '../components/Code.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons';
import { SITE } from '../lib/site';
import { softwareApplication } from '../lib/seo';
import {
  CATEGORY,
  CLARIFICATION,
  IDENTIZEN_STACK,
  TRADITIONAL_STACK,
  VERBS,
} from '../lib/positioning';

const reactSnippet = `
import { IdentizenProvider, IdentizenButton } from '@identizen/react';

export function Login() {
  return (
    <IdentizenProvider indexUrl="https://index.identizen.com" clientId={clientId}>
      <IdentizenButton login={{ redirectUri: '/api/auth/callback' }} />
    </IdentizenProvider>
  );
}`;

const cliSnippet = `
npx identizen init      # registers the site, writes .env.local, scaffolds /api/auth/*
npx identizen dev       # runs a fake phone that approves logins while you build`;

const verifySnippet = `
import { createIdentizenServer } from '@identizen/sdk/server';

const idz = createIdentizenServer({ indexUrl, clientId, clientSecret });

// Any backend, any time after enrollment: the phone shows the reason and signs it.
const v = await idz.verify({ sub, reason: 'Approve wire of $12,000 to Acme?' });
const done = await idz.waitForVerification(v.verification_id);
if (done.status === 'approved') release(wire); // assertion binds the reason hash`;

const stats = [
  { value: '60 s', label: 'challenge lifetime' },
  { value: '2-digit', label: 'match code' },
  { value: '0', label: 'secrets stored' },
  { value: '5 lines', label: 'to integrate' },
];

const steps = [
  {
    title: 'Your site asks for a login',
    text: 'The SDK requests a challenge from the index: a signed, single-use request that expires in 60 seconds and carries a two-digit match code.',
  },
  {
    title: 'The phone gets it',
    text: 'A paired browser pushes straight to the phone. Otherwise the phone is found over Bluetooth, or the user scans a QR. The match code stops relay tricks.',
  },
  {
    title: 'Face ID signs, you get OIDC',
    text: 'The phone derives a key for your site and signs the assertion. The index verifies it and hands your app a standard id_token. No email, no password.',
  },
];

const features: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'key',
    title: 'The phone is the identity',
    text: 'A seed on the device derives one key per site. Two sites cannot correlate a user, and there is no account with us to take over. Lose the phone: restore from 24 words and revoke the old one.',
  },
  {
    icon: 'shield',
    title: 'Nothing to leak',
    text: 'The index stores public keys, push tokens, and audit events. Never a private key, seed, password, or plaintext token.',
  },
  {
    icon: 'globe',
    title: 'Standard on the outside',
    text: 'Your app sees OpenID Connect with PKCE, back-channel logout, and a JWKS. Any OIDC library works; ours is just shorter.',
  },
  {
    icon: 'link',
    title: 'Pair once, then no QR',
    text: 'After the first approval the browser holds a pairing key. Later logins push to the phone directly. Revoke from the app at any time.',
  },
  {
    icon: 'bluetooth',
    title: 'Proximity when you want it',
    text: 'The phone advertises a rotating Bluetooth id. Chromium browsers can find it without a camera; the id changes every 15 minutes.',
  },
  {
    icon: 'server',
    title: 'Self-host in one command',
    text: 'The same Worker runs index.identizen.com. Deploy it to Cloudflare or run the container; indexes federate over WebFinger.',
  },
];

const platforms = [
  ['Web (any framework)', 'OIDC + @identizen/sdk', '@identizen/react'],
  ['Next.js, Remix, SvelteKit', 'Guides + CLI scaffolds', 'npx identizen init'],
  ['iPhone', 'Identizen app · in App Store review', 'Face ID'],
  ['Android', 'Identizen app · Google Play soon', 'Fingerprint'],
  ['Your own index', 'Cloudflare Worker or Docker', 'WebFinger federation'],
];
---

<Base title={SITE.name} jsonLd={[softwareApplication()]}>
  <!-- Hero -->
  <section class="bg-glow relative overflow-hidden">
    <div class="container-site pt-16 pb-16 text-center sm:pt-24 lg:pb-24">
      <p class="eyebrow justify-center">
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        {CATEGORY} · Open source · Standard OIDC
      </p>
      <h1 class="display mx-auto mt-5 max-w-4xl text-5xl sm:text-6xl lg:text-7xl">
        Identity without the <span class="accent-text">account</span>.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-fg-muted sm:text-xl">
        Your phone holds your identity. Your biometric unlocks it. Your app receives a standard
        OpenID Connect token. No password, no email, and no identity-provider account to create,
        reset, or breach.
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href={`${SITE.docs}/quickstart`} class="btn btn-primary">
          Get started
          <Icon name="arrow-right" />
        </a>
        <a href="/playground" class="btn btn-secondary">
          <Icon name="smartphone" />
          Try the playground
        </a>
      </div>
      <p
        class="mt-5 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm text-fg-muted"
      >
        <span
          class="inline-flex items-center gap-1.5 rounded-full border border-accent/30 bg-accent-soft px-2.5 py-0.5 text-xs font-medium text-accent-soft-fg"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          iOS and Android apps coming soon to the stores
        </span>
        <span>
          See a full integration at
          <a
            href="https://jtmerlin.com"
            class="text-fg underline underline-offset-2 hover:text-accent"
            rel="noopener">jtmerlin.com</a
          >, our demo bank.
        </span>
      </p>
      <div class="mt-6 flex justify-center">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-border bg-surface-0/80 py-1.5 pr-1.5 pl-4 font-mono text-sm shadow-xs backdrop-blur"
          data-code-window
        >
          <span class="text-fg-muted" aria-hidden="true">$</span>
          <pre
            class="m-0 bg-transparent p-0 font-mono text-sm text-fg">npm install @identizen/react</pre>
          <button
            type="button"
            class="inline-flex h-7 items-center gap-1 rounded-full bg-surface-2 px-2.5 text-2xs text-fg-muted hover:bg-surface-3 hover:text-fg focus-visible:outline-2 focus-visible:outline-ring"
            data-copy
            aria-label="Copy install command"
          >
            <Icon name="copy" size={12} />
            <span data-copy-label>copy</span>
          </button>
        </div>
      </div>

      <div class="mx-auto mt-16 max-w-6xl sm:mt-20">
        <HeroScene />
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-border bg-surface-1">
    <dl class="container-site grid grid-cols-2 divide-border py-8 md:grid-cols-4 md:divide-x">
      {
        stats.map((s) => (
          <div class="flex flex-col px-4 py-3 text-center md:py-1">
            <dt class="order-2 mt-1 text-sm text-fg-muted">{s.label}</dt>
            <dd class="headline tabular text-3xl sm:text-4xl">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Category -->
  <section class="section" aria-labelledby="accountless">
    <div class="container-site grid items-start gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow">{CATEGORY}</p>
        <h2 id="accountless" class="headline mt-3 text-3xl sm:text-4xl">
          Passwordless still has an account.
        </h2>
        <p class="mt-4 text-lg text-fg-muted">
          Replacing the password does not remove the identity-provider account behind it. Identizen
          does. There is no master account holding your identity. Your phone holds a cryptographic
          identity and derives a different one for every application you use. Your biometric lets
          the phone prove it, once, for one request.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-fg-muted">{CLARIFICATION}</p>
        <a href="/accountless" class="link mt-6 inline-flex items-center gap-1 text-sm">
          What accountless means, in full <Icon name="arrow-right" size={14} />
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          (
            [
              ['Traditional identity', TRADITIONAL_STACK, false],
              ['Identizen', IDENTIZEN_STACK, true],
            ] as const
          ).map(([title, stack, ours]) => (
            <div class:list={['card p-5', ours && 'border-accent/40']}>
              <p class="eyebrow">{title}</p>
              <ol class="mt-4">
                {stack.map((s, i) => (
                  <li class="relative pl-6">
                    <span
                      class:list={[
                        'absolute top-1.5 left-0 h-2.5 w-2.5 rounded-full',
                        ours ? 'bg-accent' : 'bg-border-strong',
                      ]}
                      aria-hidden="true"
                    />
                    {i < stack.length - 1 && (
                      <span
                        class="absolute top-4 left-[4px] h-[calc(100%-0.5rem)] w-px bg-border"
                        aria-hidden="true"
                      />
                    )}
                    <p class="text-sm font-medium">{s.node}</p>
                    <p class="min-h-4 pb-3 text-xs text-fg-muted">{s.note}</p>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
        <p class="text-sm text-fg-muted sm:col-span-2">
          The phone is not another factor in front of an account. It holds the identity. The index
          is in the picture because it exists: it routes requests and verifies signatures, and it
          never holds anything that could sign in as you.
        </p>
      </div>
    </div>
  </section>

  <!-- Three verbs -->
  <section class="section border-t border-border bg-surface-1" aria-labelledby="verbs">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow">One identity, three questions</p>
        <h2 id="verbs" class="headline mt-3 text-3xl sm:text-4xl">
          Authenticate. Verify. Authorize.
        </h2>
        <p class="mt-4 text-lg text-fg-muted">
          The same phone-held key answers all three. Start with login, add the other two when an
          action deserves them.
        </p>
      </div>
      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {
          VERBS.map((v) => (
            <li class="card card-hover p-6">
              <span class="icon-tile">
                <Icon name={v.icon} />
              </span>
              <h3 class="mt-5 font-semibold tracking-tight">{v.verb}</h3>
              <p class="mt-1 font-mono text-xs text-accent">“{v.quote}”</p>
              <p class="mt-3 text-sm leading-relaxed text-fg-muted">{v.text}</p>
              <a
                href={v.href}
                class="link mt-4 inline-flex items-center gap-1 text-sm"
                rel={v.href.startsWith('http') ? 'noopener' : undefined}
              >
                Learn more <Icon name="arrow-right" size={14} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section class="section border-t border-border" aria-labelledby="how">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow">How it works</p>
        <h2 id="how" class="headline mt-3 text-3xl sm:text-4xl">Three hops, one tap.</h2>
        <p class="mt-4 text-lg text-fg-muted">
          Challenge in, signed assertion out. Every step is specified, signed, and verifiable by
          anyone running the open-source index.
        </p>
      </div>
      <div class="relative mt-12">
        <div
          class="absolute top-6 right-[16%] left-[16%] hidden h-px bg-gradient-to-r from-accent/40 via-border-strong to-accent/40 md:block"
          aria-hidden="true"
        >
        </div>
        <ol class="relative grid gap-8 md:grid-cols-3 md:gap-6">
          {
            steps.map((s, i) => (
              <li class="relative">
                <span class="tabular relative inline-flex h-12 w-12 items-center justify-center rounded-full border border-border bg-surface-0 font-mono text-sm font-semibold text-accent shadow-xs">
                  0{i + 1}
                </span>
                <h3 class="mt-5 text-lg font-semibold tracking-tight">{s.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-fg-muted">{s.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- DX -->
  <section class="section border-t border-border bg-surface-1" aria-labelledby="dx">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow">Developer experience</p>
        <h2 id="dx" class="headline mt-3 text-3xl sm:text-4xl">
          Built for the afternoon you have.
        </h2>
        <p class="mt-4 text-lg text-fg-muted">
          A typed SDK, a React component with accessible states, and a CLI that registers your site
          and scaffolds the callback route. If a quickstart step needs explaining, we treat it as a
          bug.
        </p>
        <ul class="mt-6 space-y-3 text-sm">
          {
            [
              'Works with any OIDC library; the SDK is optional.',
              'Fake phone for local development and CI, no device needed.',
              'Framework guides for Next.js, Remix, SvelteKit, and plain Node.',
            ].map((t) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 items-center justify-center rounded-full bg-success-soft text-success-soft-fg">
                  <Icon name="check" size={12} />
                </span>
                <span class="text-fg-muted">{t}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/developers" class="btn btn-secondary btn-sm">For developers</a>
          <a href={`${SITE.docs}/quickstart`} class="link inline-flex items-center gap-1 text-sm">
            Read the quickstart <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>
      <div class="grid gap-4">
        <Code code={reactSnippet} lang="tsx" title="app/login.tsx" />
        <Code code={cliSnippet} lang="sh" title="terminal" />
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section" aria-labelledby="why">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow">Why it holds up</p>
        <h2 id="why" class="headline mt-3 text-3xl sm:text-4xl">
          The index is a phonebook, not a vault.
        </h2>
        <p class="mt-4 text-lg text-fg-muted">
          Everything we host must be safe to leak. That single constraint shapes the protocol.
        </p>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((f) => (
            <li class="card card-hover p-6">
              <span class="icon-tile">
                <Icon name={f.icon} />
              </span>
              <h3 class="mt-5 font-semibold tracking-tight">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-fg-muted">{f.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Path B -->
  <section class="section border-t border-border bg-surface-1" aria-labelledby="pathb">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <Code
        code={verifySnippet}
        lang="ts"
        title="server/approve-wire.ts"
        class="order-2 lg:order-1"
      />
      <div class="order-1 lg:order-2">
        <p class="eyebrow">Authorize</p>
        <h2 id="pathb" class="headline mt-3 text-3xl sm:text-4xl">
          Don't just authenticate the user. Prove they approved the action.
        </h2>
        <p class="mt-4 text-lg text-fg-muted">
          Keep your existing login if you like. Bind a person's phone once, then send it the exact
          action: a wire transfer, a production deploy, an admin grant. The text is shown on the
          phone and bound into the signature, so an approval cannot be replayed for something else.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a href="/authorization" class="link inline-flex items-center gap-1 text-sm">
            Signed authorization <Icon name="arrow-right" size={14} />
          </a>
          <a href={`${SITE.docs}/add-mfa`} class="link inline-flex items-center gap-1 text-sm">
            Add MFA to an existing app <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Platforms -->
  <section class="section" aria-labelledby="platforms">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow">Where it runs</p>
        <h2 id="platforms" class="headline mt-3 text-3xl sm:text-4xl">
          One protocol, every surface.
        </h2>
      </div>
      <div class="card mt-10 overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-surface-1 text-left text-fg-muted">
            <tr>
              <th scope="col" class="px-5 py-3 font-medium">Surface</th>
              <th scope="col" class="px-5 py-3 font-medium">Integration</th>
              <th scope="col" class="px-5 py-3 font-medium">Ships with</th>
            </tr>
          </thead>
          <tbody>
            {
              platforms.map(([a, b, c]) => (
                <tr class="border-t border-border">
                  <th scope="row" class="px-5 py-3 text-left font-medium">
                    {a}
                  </th>
                  <td class="px-5 py-3 text-fg-muted">{b}</td>
                  <td class="px-5 py-3 font-mono text-xs text-fg-muted">{c}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-site pb-24">
    <div
      class="card-gradient bg-glow relative overflow-hidden px-6 py-14 text-center sm:px-12 sm:py-20"
    >
      <div class="bg-dots absolute inset-0 -z-0" aria-hidden="true"></div>
      <div class="relative">
        <h2 class="headline text-3xl sm:text-4xl">Add accountless identity this afternoon.</h2>
        <p class="mx-auto mt-4 max-w-xl text-lg text-fg-muted">
          Register a site, drop in the button, and approve your first login with the phone in your
          pocket. Free for personal identities, forever.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href={`${SITE.docs}/quickstart`} class="btn btn-primary">
            Read the quickstart
            <Icon name="arrow-right" />
          </a>
          <a href={SITE.github} rel="noopener" class="btn btn-secondary">
            <Icon name="git-branch" />
            View the source
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
