---
import Base from '../layouts/Base.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { SITE } from '../lib/site';

const reactSnippet = `
import { IdentizenProvider, IdentizenButton } from '@identizen/react';

<IdentizenProvider indexUrl="https://index.identizen.com" clientId="idz_live_...">
  <IdentizenButton onSuccess={(user) => router.push('/dashboard')} />
</IdentizenProvider>`;

const cliSnippet = `
npx identizen init   # registers your site, writes .env, scaffolds /api/auth/*
npx identizen dev    # a fake phone that approves logins while you build`;

const verifySnippet = `
POST /v1/verify
Authorization: Bearer <client_secret>
Idz-Client-Id: idz_live_...

{ "sub": "…", "reason": "Approve wire transfer of $12,000 to Acme?" }

→ { "verification_id": "vf_…", "status": "pending" }
→ poll or webhook: "approved" + the signed assertion (reason hash inside)`;

const steps = [
  {
    title: 'One click on the site',
    body: 'The site starts a standard OIDC login. The index creates a 60-second challenge that names the site, a nonce, and a two-digit match code.',
  },
  {
    title: 'The phone is found',
    body: 'A paired browser pushes straight to your phone. First time? Chromium finds it over Bluetooth, or you scan a QR. On the phone itself, a link opens the app.',
  },
  {
    title: 'Face ID, in',
    body: 'The phone shows the site name and the code, you approve with biometrics, and the site gets an id_token with a per-site sub. No email. No password. Nothing to remember.',
  },
];

const matrix = [
  ['Chrome / Edge desktop', '✓', '✓', '✓', '—'],
  ['Safari macOS', '✓', '—', '✓', '—'],
  ['Firefox desktop', '✓', '—', '✓', '—'],
  ['Safari iOS', '—', '—', '—', '✓'],
  ['Chrome Android', '—', '—', '—', '✓'],
];
---

<Base title={SITE.name}>
  <section class="grid gap-10 py-6 sm:py-14 lg:grid-cols-[1.15fr_1fr] lg:items-center">
    <div class="max-w-2xl">
      <p
        class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-surface-1 px-3 py-1 text-xs text-fg-muted"
      >
        <span class="size-1.5 rounded-full bg-success" aria-hidden="true"></span> Open source · Apache-2.0
        · Standard OIDC
      </p>
      <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
        Login with your phone.
      </h1>
      <p class="mt-5 max-w-xl text-lg text-fg-muted text-pretty">
        No password, no email, no Google or Microsoft account. One tap, Face ID, in.
      </p>
      <p class="mt-3 max-w-xl text-base text-fg-muted text-pretty">
        Identizen is a device-based identity system. Your phone holds the key; sites integrate a
        standard OpenID Connect provider in five lines. The index we host is a phonebook, not a
        vault.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={`${SITE.docs}/quickstart`}
          class="inline-flex h-11 items-center rounded-lg bg-accent px-6 text-base font-medium text-accent-fg hover:bg-accent-hover"
          >Start in 5 minutes</a
        >
        <a
          href="/playground"
          class="inline-flex h-11 items-center rounded-lg border border-border-strong bg-surface-0 px-6 text-base font-medium hover:bg-surface-1"
          >Try it with your phone</a
        >
      </div>
      <p class="mt-6 font-mono text-sm text-fg-muted">npm install @identizen/react</p>
    </div>
    <div class="relative">
      <svg viewBox="0 0 520 300" role="img" aria-labelledby="flow-title flow-desc" class="w-full">
        <title id="flow-title">How a login flows</title>
        <desc id="flow-desc"
          >A browser sends a challenge through the index to a phone; the phone signs it after a
          biometric check and the browser is logged in.</desc
        >
        <defs>
          <marker
            id="arrow"
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="6"
            markerHeight="6"
            orient="auto-start-reverse"
          >
            <path d="M0 0L10 5L0 10z" fill="var(--color-fg-subtle)"></path>
          </marker>
        </defs>
        <g font-family="ui-monospace, Menlo, monospace" font-size="12" fill="var(--color-fg-muted)">
          <rect
            x="16"
            y="90"
            width="150"
            height="120"
            rx="12"
            fill="var(--color-surface-1)"
            stroke="var(--color-border)"></rect>
          <text x="91" y="120" text-anchor="middle" fill="var(--color-fg)" font-weight="600"
            >Browser</text
          >
          <text x="91" y="142" text-anchor="middle">site + SDK</text>
          <rect x="52" y="160" width="78" height="30" rx="6" fill="var(--color-accent-soft)"></rect>
          <text
            x="91"
            y="180"
            text-anchor="middle"
            fill="var(--color-accent-soft-fg)"
            font-weight="600">code 47</text
          >

          <rect
            x="200"
            y="60"
            width="120"
            height="180"
            rx="12"
            fill="var(--color-surface-1)"
            stroke="var(--color-border)"></rect>
          <text x="260" y="90" text-anchor="middle" fill="var(--color-fg)" font-weight="600"
            >Index</text
          >
          <text x="260" y="112" text-anchor="middle">public keys</text>
          <text x="260" y="130" text-anchor="middle">push tokens</text>
          <text x="260" y="148" text-anchor="middle">revocation</text>
          <text x="260" y="176" text-anchor="middle" fill="var(--color-fg-subtle)">no secrets</text>

          <rect
            x="370"
            y="40"
            width="120"
            height="220"
            rx="20"
            fill="var(--color-surface-1)"
            stroke="var(--color-border)"></rect>
          <text x="430" y="75" text-anchor="middle" fill="var(--color-fg)" font-weight="600"
            >Phone</text
          >
          <text x="430" y="100" text-anchor="middle">Example App</text>
          <rect x="395" y="115" width="70" height="36" rx="6" fill="var(--color-accent-soft)"
          ></rect>
          <text
            x="430"
            y="139"
            text-anchor="middle"
            fill="var(--color-accent-soft-fg)"
            font-size="18"
            font-weight="700">47</text
          >
          <circle cx="430" cy="200" r="22" fill="none" stroke="var(--color-accent)" stroke-width="3"
          ></circle>
          <text x="430" y="205" text-anchor="middle" fill="var(--color-accent)" font-size="11"
            >Face ID</text
          >

          <path
            d="M166 120 H196"
            stroke="var(--color-fg-subtle)"
            stroke-width="1.5"
            marker-end="url(#arrow)"></path>
          <text x="181" y="112" text-anchor="middle" font-size="10">challenge</text>
          <path
            d="M320 120 H366"
            stroke="var(--color-fg-subtle)"
            stroke-width="1.5"
            marker-end="url(#arrow)"></path>
          <text x="343" y="112" text-anchor="middle" font-size="10">push</text>
          <path
            d="M366 190 H324"
            stroke="var(--color-fg-subtle)"
            stroke-width="1.5"
            marker-end="url(#arrow)"></path>
          <text x="345" y="206" text-anchor="middle" font-size="10">signed</text>
          <path
            d="M196 190 H170"
            stroke="var(--color-fg-subtle)"
            stroke-width="1.5"
            marker-end="url(#arrow)"></path>
          <text x="183" y="206" text-anchor="middle" font-size="10">id_token</text>
        </g>
      </svg>
    </div>
  </section>

  <section aria-labelledby="how" class="py-14">
    <h2 id="how" class="text-2xl font-semibold tracking-tight">How it works</h2>
    <ol class="mt-8 grid gap-6 sm:grid-cols-3">
      {
        steps.map((s, i) => (
          <li class="rounded-xl border border-border bg-surface-1 p-6">
            <span class="font-mono text-2xs text-fg-muted">0{i + 1}</span>
            <h3 class="mt-2 text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="dx" class="grid gap-8 py-14 lg:grid-cols-[1fr_1.2fr] lg:items-center">
    <div>
      <h2 id="dx" class="text-2xl font-semibold tracking-tight">Five lines. Standard OIDC.</h2>
      <p class="mt-4 text-fg-muted leading-relaxed">
        Any OIDC library already works: Auth.js, Passport, Spring Security, ASP.NET Core Identity,
        Django allauth. The React binding renders the button, the match code, and the QR. The CLI
        registers your site and scaffolds the callback route, so a fresh Next.js app logs in before
        your coffee cools.
      </p>
      <ul class="mt-6 space-y-2 text-sm text-fg-muted">
        <li>· Typed SDK, documented <code class="font-mono">user</code> object</li>
        <li>· Every error has a code, a cause, and a link to the fix</li>
        <li>· Local dev mode with a fake phone — no device needed</li>
      </ul>
    </div>
    <div class="grid gap-4">
      <CodeBlock code={reactSnippet} lang="tsx" title="app/login.tsx" />
      <CodeBlock code={cliSnippet} lang="sh" title="terminal" />
    </div>
  </section>

  <section
    aria-labelledby="pathb"
    class="grid gap-8 py-14 lg:grid-cols-[1.2fr_1fr] lg:items-center"
  >
    <CodeBlock
      code={verifySnippet}
      lang="http"
      title="Verification API"
      class="order-2 lg:order-1"
    />
    <div class="order-1 lg:order-2">
      <h2 id="pathb" class="text-2xl font-semibold tracking-tight">
        Or keep your login and add the factor.
      </h2>
      <p class="mt-4 text-fg-muted leading-relaxed">
        Replace SMS codes and authenticator apps with a push to the user's phone, approved with Face
        ID. Use OIDC step-up (<code class="font-mono text-sm">acr_values=idz:mfa</code>) with the
        library you already have, or the Duo-style Verification API from any backend. The <code
          class="font-mono text-sm">reason</code
        > is shown on the phone and signed into the assertion — transaction signing you can prove.
      </p>
    </div>
  </section>

  <section aria-labelledby="sov" class="rounded-2xl border border-border bg-surface-1 p-8 sm:p-12">
    <h2 id="sov" class="text-2xl font-semibold tracking-tight">
      The index is a phonebook, not a vault.
    </h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-3 text-sm leading-relaxed text-fg-muted">
      <p>
        <strong class="text-fg">No shared secrets.</strong> Private keys are generated on-device and never
        leave it. A breach of any Identizen-hosted system yields public keys.
      </p>
      <p>
        <strong class="text-fg">No big tech in the chain.</strong> Not Google, not Microsoft, not Apple's
        keychain. Push transport is the one unavoidable dependency, and it only carries a challenge id.
      </p>
      <p>
        <strong class="text-fg">Fully self-hostable.</strong> One Cloudflare Worker or one container.
        Federated indexes resolve handles over WebFinger. If we vanish, your users still log in.
      </p>
    </div>
  </section>

  <section aria-labelledby="matrix" class="py-14">
    <h2 id="matrix" class="text-2xl font-semibold tracking-tight">Works everywhere, by layers.</h2>
    <p class="mt-3 max-w-2xl text-fg-muted">
      After the first login a browser is paired, so repeat logins push straight to the phone on
      every browser. Bluetooth and QR only ever cover the first time.
    </p>
    <div class="mt-6 overflow-x-auto rounded-xl border border-border">
      <table class="w-full text-sm">
        <thead class="bg-surface-1 text-left text-fg-muted">
          <tr>
            <th scope="col" class="px-4 py-3 font-medium">Browser / OS</th>
            <th scope="col" class="px-4 py-3 font-medium">Paired push</th>
            <th scope="col" class="px-4 py-3 font-medium">Bluetooth</th>
            <th scope="col" class="px-4 py-3 font-medium">QR</th>
            <th scope="col" class="px-4 py-3 font-medium">Deep link</th>
          </tr>
        </thead>
        <tbody>
          {
            matrix.map(([name, ...cells]) => (
              <tr class="border-t border-border">
                <th scope="row" class="px-4 py-3 text-left font-medium">
                  {name}
                </th>
                {cells.map((c) => (
                  <td class="px-4 py-3 font-mono text-fg-muted">{c}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section
    class="flex flex-wrap items-center justify-between gap-6 rounded-2xl bg-accent p-8 text-accent-fg sm:p-12"
  >
    <div>
      <h2 class="text-2xl font-semibold tracking-tight">Ship it this afternoon.</h2>
      <p class="mt-2">Quickstart, framework guides, and the protocol spec — all in the docs.</p>
    </div>
    <div class="flex gap-3">
      <a
        href={`${SITE.docs}/quickstart`}
        class="inline-flex h-11 items-center rounded-lg bg-surface-0 px-6 font-medium text-fg"
        >Read the quickstart</a
      >
      <a
        href={SITE.github}
        rel="noopener"
        class="inline-flex h-11 items-center rounded-lg border border-accent-fg/40 px-6 font-medium"
        >GitHub</a
      >
    </div>
  </section>
</Base>
