---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { BRAND_ASSETS, BRAND_RED, inlineSvg } from '../lib/brand';

const asset = (file: string) => {
  const a = BRAND_ASSETS.find((x) => x.file === file);
  if (!a) throw new Error(`brand asset ${file} missing`);
  return a.svg;
};
const lockup = asset('identizen-lockup.svg');
const lockupSeal = asset('identizen-lockup-seal.svg');
const mark = asset('kimi-mark.svg');
const seal = asset('kimi-seal.svg');
const sealInk = asset('kimi-seal-ink.svg');
const wordmark = asset('identizen-wordmark.svg');

const gridLines = Array.from({ length: 11 }, (_, i) => i * 10);
const markInner = mark.replace(/<svg[^>]*>/, '').replace('</svg>', '');

const colors = [
  { name: 'Ink', value: '#17171A', note: 'Mark and wordmark on light grounds.' },
  { name: 'Paper', value: '#FAFAF7', note: 'Mark and wordmark on dark grounds.' },
  { name: 'Vermilion', value: BRAND_RED, note: 'The seal, or the dot on the i. Once per composition.' },
  { name: 'Accent', value: 'oklch(0.55 0.19 30)', note: 'Product red for buttons and links, one step deeper than the seal so white text passes AA.' },
];

const specs = [
  ['Stroke', '8 units on a 100-unit grid, round caps and joins'],
  ['Width', '80 units, set by the long second bar'],
  ['口 box', '42 × 31, corner radius 5.5'],
  ['Sweep', 'one cubic from the top bar to the lower left'],
  ['Minimum', '16 px for the mark, 20 px for the logo'],
  ['Clear space', 'the width of the 口 box on every side'],
];
---

<Base
  title="Brand"
  description="The Identizen mark is 君, the Japanese word for you, drawn as a monoline. Download the logo, wordmark and seal as SVG, with the rules for using them."
>
  <PageHeader
    eyebrow="Brand"
    title="The mark is 君. It means you."
    lede="Identizen puts a person, not an account, at the center. 君 (kimi) is the plain Japanese word for the person you are speaking to, and in Japan a name pressed in vermilion ink is still what makes a document yours. Everything on this page is free to use when you write about or integrate Identizen."
  />

  <section class="container-site pb-16 sm:pb-20">
    <div class="grid gap-4 md:grid-cols-2">
      <div
        class="flex min-h-56 items-center justify-center rounded-2xl border border-border bg-surface-0 p-10 text-fg"
      >
        <Fragment set:html={inlineSvg(lockup, 64, 'max-w-full')} />
      </div>
      <div
        class="flex min-h-56 items-center justify-center rounded-2xl border border-[#2A2A30] bg-[#121215] p-10 text-[#F2F1EC]"
      >
        <Fragment set:html={inlineSvg(lockup, 64, 'max-w-full')} />
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-surface-1">
    <div class="container-site grid gap-12 py-16 sm:py-20 md:grid-cols-2 md:items-center">
      <svg
        viewBox="-8 -10 118 116"
        class="mx-auto w-full max-w-md text-fg"
        role="img"
        aria-label="Construction of the 君 mark on a 100 unit grid"
      >
        <g class="stroke-border" stroke-width="0.35">
          {gridLines.map((v) => <line x1={v} y1="0" x2={v} y2="100" />)}
          {gridLines.map((v) => <line x1="0" y1={v} x2="100" y2={v} />)}
        </g>
        <Fragment set:html={markInner} />
        <g stroke={BRAND_RED} stroke-width="0.6" fill={BRAND_RED} font-size="3.2" font-weight="600">
          <line x1="10" y1="-4" x2="90" y2="-4"></line>
          <text x="50" y="-6" text-anchor="middle" stroke="none">80</text>
          <line x1="104" y1="61" x2="104" y2="92"></line>
          <text x="107.5" y="77.5" text-anchor="middle" stroke="none" transform="rotate(90 107.5 77.5)"
            >31</text
          >
        </g>
      </svg>
      <div>
        <p class="eyebrow">Construction</p>
        <h2 class="headline mt-3 text-3xl sm:text-4xl">Five strokes, one weight.</h2>
        <p class="mt-4 text-fg-muted">
          君 is drawn in the order a hand would write it. Every terminal is round, every stroke is
          the same weight, and the bottom element 口 is a rounded box: the seal that sits under a
          name. Nothing is traced from a font, so the mark is ours and scales down to a favicon
          without filling in.
        </p>
        <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2.5 text-sm">
          {
            specs.map(([k, v]) => (
              <>
                <dt class="text-fg-muted">{k}</dt>
                <dd class="text-fg">{v}</dd>
              </>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="container-site py-16 sm:py-20">
    <p class="eyebrow">Type and color</p>
    <h2 class="headline mt-3 text-3xl sm:text-4xl">Two faces, one red.</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-[1.4fr_1fr]">
      <div class="rounded-2xl border border-border p-8">
        <p class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">
          Login with your phone.
        </p>
        <p class="mt-3 text-fg-muted">
          Headlines and the wordmark are Bricolage Grotesque SemiBold. Everything you read, click
          or type is Inter. Code is the system monospace.
        </p>
        <div class="mt-6 text-fg">
          <Fragment set:html={inlineSvg(wordmark, 30)} />
        </div>
      </div>
      <ul class="grid gap-3">
        {
          colors.map((c) => (
            <li class="flex items-center gap-4 rounded-2xl border border-border p-4">
              <span
                class="size-12 shrink-0 rounded-xl border border-border-strong/40"
                style={`background:${c.value}`}
                aria-hidden="true"
              />
              <div class="min-w-0">
                <p class="flex flex-wrap items-baseline gap-x-3 font-medium">
                  {c.name}
                  <code class="font-mono text-xs text-fg-muted">{c.value}</code>
                </p>
                <p class="mt-0.5 text-sm text-fg-muted">{c.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-border bg-surface-1">
    <div class="container-site py-16 sm:py-20">
      <p class="eyebrow">Usage</p>
      <h2 class="headline mt-3 text-3xl sm:text-4xl">Vermilion appears once.</h2>
      <p class="mt-4 max-w-2xl text-fg-muted">
        Either the seal is red and the wordmark is ink, or the mark is ink and the first i carries
        the dot. Never both. Keep the mark in ink on paper and paper on sumi; the product accent is
        for the product.
      </p>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        <div class="rounded-2xl border border-border bg-surface-0 p-6 text-fg">
          <div class="flex h-16 items-center"><Fragment set:html={inlineSvg(lockup, 36)} /></div>
          <p class="mt-3 flex items-center gap-1.5 text-sm font-medium text-fg">
            <span class="text-success" aria-hidden="true"><Icon name="check" size={14} /></span> Ink mark, dotted wordmark
          </p>
          <p class="mt-1 text-sm text-fg-muted">The default. Headers, docs, README, email.</p>
        </div>
        <div class="rounded-2xl border border-border bg-surface-0 p-6 text-fg">
          <div class="flex h-16 items-center"><Fragment set:html={inlineSvg(lockupSeal, 36)} /></div>
          <p class="mt-3 flex items-center gap-1.5 text-sm font-medium text-fg">
            <span class="text-success" aria-hidden="true"><Icon name="check" size={14} /></span> Red seal, plain wordmark
          </p>
          <p class="mt-1 text-sm text-fg-muted">App listings, social cards, avatars.</p>
        </div>
        <div class="rounded-2xl border border-border bg-surface-0 p-6 text-fg">
          <div class="flex h-16 items-center gap-6">
            <Fragment set:html={inlineSvg(seal, 40)} />
            <Fragment set:html={inlineSvg(sealInk, 40)} />
            <Fragment set:html={inlineSvg(seal, 20)} />
          </div>
          <p class="mt-3 flex items-center gap-1.5 text-sm font-medium text-fg">
            <span class="text-success" aria-hidden="true"><Icon name="check" size={14} /></span> Seal as icon
          </p>
          <p class="mt-1 text-sm text-fg-muted">Red by default, ink on dark grounds, down to 16 px.</p>
        </div>
      </div>
      <ul class="mt-6 grid gap-2 text-sm text-fg-muted sm:grid-cols-2">
        <li class="flex gap-2"><span class="text-danger" aria-hidden="true">×</span> No uppercase wordmark, no Inter wordmark.</li>
        <li class="flex gap-2"><span class="text-danger" aria-hidden="true">×</span> No circular seal, no gradients, no outlines or shadows.</li>
        <li class="flex gap-2"><span class="text-danger" aria-hidden="true">×</span> No red seal next to the dotted wordmark.</li>
        <li class="flex gap-2"><span class="text-danger" aria-hidden="true">×</span> No recoloring the mark in the product accent.</li>
      </ul>
    </div>
  </section>

  <section class="container-site py-16 sm:py-20">
    <p class="eyebrow">Downloads</p>
    <h2 class="headline mt-3 text-3xl sm:text-4xl">Every asset, as SVG.</h2>
    <p class="mt-4 max-w-2xl text-fg-muted">
      Plain SVG with no font dependency. Files marked currentColor take the color of the text
      around them when inlined.
    </p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-testid="brand-downloads">
      {
        BRAND_ASSETS.map((a) => (
          <li class="flex flex-col rounded-2xl border border-border">
            <div
              class:list={[
                'flex h-36 items-center justify-center rounded-t-2xl p-6',
                a.ground === 'paper' ? 'bg-[#FAFAF7] text-[#17171A]' : 'bg-surface-1 text-fg',
              ]}
            >
              <Fragment set:html={inlineSvg(a.svg, a.file.includes('lockup') ? 36 : 64, 'max-w-full')} />
            </div>
            <div class="flex flex-1 flex-col p-5">
              <p class="font-medium">{a.name}</p>
              <p class="mt-1 flex-1 text-sm text-fg-muted">{a.use}</p>
              <a
                href={`/brand/${a.file}`}
                download
                class="btn btn-secondary btn-sm mt-4 self-start"
              >
                <Icon name="download" size={14} />
                {a.file.replace('alt/', '')}
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
