---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const field =
  'h-11 rounded-md border border-input bg-surface-0 px-3 text-sm shadow-xs transition-colors focus:border-accent focus:outline-2 focus:outline-ring aria-[invalid=true]:border-danger';
---

<Base
  title="Contact"
  description="Talk to the Identizen team about the enterprise tier, migrations, or anything else."
>
  <section class="bg-glow">
    <div class="container-site grid gap-12 py-16 sm:py-24 lg:grid-cols-[1fr_1.2fr]">
      <header>
        <p class="eyebrow">Contact</p>
        <h1 class="headline mt-3 text-4xl sm:text-5xl">Talk to us.</h1>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-fg-muted">
          Enterprise pilots, migrations from an existing IdP, security questions, or a bug you want
          to walk through.
        </p>
        <ul class="mt-8 space-y-3 text-sm">
          <li class="flex items-center gap-3">
            <span class="icon-tile h-9 w-9"><Icon name="mail" /></span>
            <span>
              <span class="block text-fg-muted">Prefer email?</span>
              <a class="link" href="mailto:hello@identizen.com">hello@identizen.com</a>
            </span>
          </li>
          <li class="flex items-center gap-3">
            <span class="icon-tile h-9 w-9"><Icon name="shield" /></span>
            <span>
              <span class="block text-fg-muted">Security reports</span>
              <a class="link" href="mailto:security@identizen.com">security@identizen.com</a>
            </span>
          </li>
        </ul>
      </header>

      <form
        id="contact"
        method="post"
        action="/api/contact"
        novalidate
        class="card grid gap-5 p-6 sm:p-8"
      >
        <div class="grid gap-1.5">
          <label for="name" class="text-sm font-medium">Name</label>
          <input id="name" name="name" autocomplete="name" required minlength="2" class={field} />
          <p class="text-xs text-danger" data-error-for="name" aria-live="polite"></p>
        </div>
        <div class="grid gap-1.5">
          <label for="email" class="text-sm font-medium">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class={field} />
          <p class="text-xs text-danger" data-error-for="email" aria-live="polite"></p>
        </div>
        <div class="grid gap-1.5">
          <label for="message" class="text-sm font-medium">Message</label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            minlength="10"
            class:list={[field, 'h-auto py-2']}></textarea>
          <p class="text-xs text-danger" data-error-for="message" aria-live="polite"></p>
        </div>
        {siteKey ? <div class="cf-turnstile" data-sitekey={siteKey} data-theme="auto" /> : null}
        <button type="submit" class="btn btn-primary justify-self-start">Send</button>
        <p id="contact-status" role="status" aria-live="polite" class="text-sm text-fg-muted"></p>
      </form>
    </div>
  </section>
  {
    siteKey ? (
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
    ) : null
  }
  <script>
    import { validateContact } from '../lib/contact';

    const form = document.getElementById('contact') as HTMLFormElement;
    const status = document.getElementById('contact-status') as HTMLElement;
    const show = (errors: Record<string, string | undefined>) => {
      for (const el of form.querySelectorAll<HTMLElement>('[data-error-for]')) {
        const key = el.dataset.errorFor ?? '';
        el.textContent = errors[key] ?? '';
        const input = form.elements.namedItem(key) as HTMLElement | null;
        input?.setAttribute('aria-invalid', errors[key] ? 'true' : 'false');
      }
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());
      const token = data['cf-turnstile-response'];
      const result = validateContact({ ...data, token });
      show(result.errors);
      if (!result.ok) {
        status.textContent = 'Please fix the highlighted fields.';
        return;
      }
      status.textContent = 'Sending…';
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(result.value),
        });
        const body = (await res.json()) as { ok: boolean; error?: string };
        status.textContent = body.ok
          ? 'Thanks. We will reply by email.'
          : `Could not send: ${body.error ?? res.status}`;
        if (body.ok) form.reset();
      } catch {
        status.textContent = 'Could not send. Email hello@identizen.com instead.';
      }
    });
  </script>
</Base>
