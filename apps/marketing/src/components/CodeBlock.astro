---
interface Props {
  code: string;
  lang?: string;
  title?: string;
  class?: string;
}
const { code, lang = 'ts', title, class: className } = Astro.props;
---

<figure
  class:list={[
    'overflow-hidden rounded-lg border border-border bg-surface-1 text-sm shadow-xs',
    className,
  ]}
>
  {
    title && (
      <figcaption class="flex items-center justify-between border-b border-border px-4 py-2 font-mono text-2xs uppercase tracking-wide text-fg-muted">
        <span>{title}</span>
        <span>{lang}</span>
      </figcaption>
    )
  }
  <pre
    class="overflow-x-auto p-4 leading-relaxed"
    tabindex="0"><code class={`language-${lang}`}>{code.trim()}</code></pre>
</figure>
