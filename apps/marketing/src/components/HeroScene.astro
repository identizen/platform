---
import { qrSvg } from '@identizen/sdk';
import BrowserMock from './BrowserMock.astro';
import PhoneMock from './PhoneMock.astro';
import FaceId from './FaceId.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const CODE = '47';
const qr = qrSvg('https://app.identizen.com/l/ch_01J9Z2K4M7N8P1Q3R5S7T9V1WX', {
  cell: 3,
  label: 'Example QR code for the login',
});
---

<div class="scene relative" aria-describedby="scene-desc">
  <p id="scene-desc" class="sr-only">
    A browser on acme.com/login shows a Continue with Identizen button, a QR code and the match code {
      CODE
    }. The challenge travels to the index, the index pushes it to the phone, and the phone shows
    Acme, the same match code, and Approve with Face ID. The signed assertion returns to the
    browser.
  </p>
  <div class="bg-grid absolute -inset-x-6 -inset-y-10 -z-10" aria-hidden="true"></div>

  <div
    class="relative flex flex-col items-center gap-6 lg:flex-row lg:items-center lg:justify-center lg:gap-0"
  >
    <!-- Browser -->
    <BrowserMock url="acme.com/login" class="w-full max-w-[34rem] lg:w-[34rem]">
      <div class="grid gap-6 p-5 sm:grid-cols-[1.1fr_1fr] sm:p-7" aria-hidden="true">
        <div>
          <div class="flex items-center gap-2">
            <span
              class="inline-block h-6 w-6 rounded-md bg-fg"
              style="clip-path: polygon(0 0, 100% 0, 100% 65%, 65% 100%, 0 100%)"></span>
            <span class="text-sm font-semibold tracking-tight">Acme</span>
          </div>
          <p class="mt-6 text-lg font-semibold tracking-tight">Welcome back</p>
          <p class="mt-1 text-xs text-fg-muted">Sign in to continue to your workspace.</p>
          <div
            class="mt-5 flex h-10 items-center justify-center gap-2 rounded-md bg-fg text-sm font-medium text-fg-inverse shadow-sm"
          >
            <Logo variant="mark" height={16} />
            Continue with Identizen
          </div>
          <div class="mt-4 flex items-center gap-3 text-2xs text-fg-subtle">
            <span class="h-px flex-1 bg-border"></span>or<span class="h-px flex-1 bg-border"></span>
          </div>
          <div class="mt-4 h-9 rounded-md border border-border bg-surface-1 px-3 text-xs">
            <span class="flex h-full items-center text-fg-subtle">name@company.com</span>
          </div>
          <div
            class="mt-2 flex h-9 items-center justify-center rounded-md border border-border-strong text-xs font-medium text-fg-muted"
          >
            Continue with email
          </div>
        </div>
        <div
          class="flex flex-col items-center justify-center rounded-lg border border-border bg-surface-1 p-4 text-center"
        >
          <div
            class="rounded-md bg-white p-1.5 shadow-xs ring-1 ring-border [&_svg]:h-24 [&_svg]:w-24"
            set:html={qr}
          />
          <p class="mt-3 text-2xs text-fg-muted">Scan with the Identizen app</p>
          <p class="mt-2 text-2xs text-fg-muted">Match code</p>
          <p class="tabular font-mono text-2xl font-semibold tracking-tight">{CODE}</p>
          <p class="mt-2 flex items-center gap-1.5 text-2xs text-fg-muted">
            <span class="relative flex h-2 w-2">
              <span
                class="animate-pulse-ring absolute inline-flex h-full w-full rounded-full bg-accent"
              ></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
            </span>
            Waiting for your phone…
          </p>
        </div>
      </div>
    </BrowserMock>

    <!-- Flow (desktop) -->
    <div class="relative hidden w-52 shrink-0 lg:block" aria-hidden="true">
      <svg viewBox="0 0 208 220" class="h-auto w-full overflow-visible text-fg-muted" fill="none">
        <defs>
          <linearGradient id="flow-grad" x1="0" x2="1">
            <stop offset="0" stop-color="var(--color-accent)" stop-opacity="0.3"></stop>
            <stop offset="0.5" stop-color="var(--color-accent)"></stop>
            <stop offset="1" stop-color="var(--color-accent)" stop-opacity="0.3"></stop>
          </linearGradient>
          <marker
            id="arrow"
            viewBox="0 0 8 8"
            refX="6"
            refY="4"
            markerWidth="7"
            markerHeight="7"
            orient="auto-start-reverse"
          >
            <path d="M0 0.5 L7 4 L0 7.5z" fill="var(--color-accent)"></path>
          </marker>
        </defs>
        <!-- base tracks -->
        <path d="M0 92 H68" stroke="var(--color-border-strong)" stroke-width="1.5"></path>
        <path d="M140 92 H208" stroke="var(--color-border-strong)" stroke-width="1.5"></path>
        <path
          d="M208 156 C 170 156, 150 178, 104 178 C 58 178, 38 156, 0 156"
          stroke="var(--color-border-strong)"
          stroke-width="1.5"></path>
        <!-- animated flow -->
        <path
          d="M0 92 H60"
          stroke="url(#flow-grad)"
          stroke-width="2"
          stroke-dasharray="3 5"
          stroke-linecap="round"
          class="animate-flow"
          marker-end="url(#arrow)"></path>
        <path
          d="M140 92 H200"
          stroke="url(#flow-grad)"
          stroke-width="2"
          stroke-dasharray="3 5"
          stroke-linecap="round"
          class="animate-flow"
          marker-end="url(#arrow)"></path>
        <path
          d="M208 156 C 170 156, 150 178, 104 178 C 58 178, 38 156, 8 156"
          stroke="url(#flow-grad)"
          stroke-width="2"
          stroke-dasharray="3 5"
          stroke-linecap="round"
          class="animate-flow"
          marker-end="url(#arrow)"></path>
        <!-- index node -->
        <rect
          x="68"
          y="76"
          width="72"
          height="32"
          rx="10"
          fill="var(--color-surface-0)"
          stroke="var(--color-border-strong)"
          stroke-width="1.5"></rect>
        <rect x="78" y="85" width="14" height="14" rx="4" fill="var(--color-accent)"></rect>
        <g
          transform="translate(79.5 86.5) scale(0.11)"
          fill="none"
          stroke="var(--color-accent-fg)"
          stroke-width="11"
          stroke-linecap="round"
          stroke-linejoin="round">
          <path d="M22 15 H72"></path>
          <path d="M10 31 H90"></path>
          <path d="M25 47 H66"></path>
          <path d="M47 12 C46 32 44 54 9 74"></path>
          <rect x="35" y="61" width="42" height="31" rx="5.5"></rect>
        </g>
        <text
          x="98"
          y="96"
          font-family="var(--font-mono)"
          font-size="10"
          font-weight="600"
          fill="var(--color-fg)">index</text
        >
        <!-- labels -->
        <text
          x="30"
          y="80"
          text-anchor="middle"
          font-family="var(--font-mono)"
          font-size="9"
          letter-spacing="0.08em"
          fill="currentColor">CHALLENGE</text
        >
        <text
          x="172"
          y="80"
          text-anchor="middle"
          font-family="var(--font-mono)"
          font-size="9"
          letter-spacing="0.08em"
          fill="currentColor">PUSH</text
        >
        <text
          x="104"
          y="196"
          text-anchor="middle"
          font-family="var(--font-mono)"
          font-size="9"
          letter-spacing="0.08em"
          fill="currentColor">SIGNED ASSERTION</text
        >
      </svg>
    </div>

    <!-- Flow (mobile) -->
    <ol
      class="flex flex-wrap items-center justify-center gap-2 font-mono text-2xs uppercase tracking-wider text-fg-muted lg:hidden"
      aria-hidden="true"
    >
      <li class="rounded-full border border-border bg-surface-0 px-3 py-1">challenge</li>
      <li><Icon name="arrow-right" size={12} /></li>
      <li class="rounded-full border border-border bg-surface-0 px-3 py-1">index pushes</li>
      <li><Icon name="arrow-right" size={12} /></li>
      <li
        class="rounded-full border border-accent-soft bg-accent-soft px-3 py-1 text-accent-soft-fg"
      >
        signed assertion
      </li>
    </ol>

    <!-- Phone -->
    <PhoneMock class="animate-fade-up">
      <div class="flex h-full flex-col px-4 pt-3 pb-4">
        <div class="flex items-center justify-between px-1 text-[0.6rem] font-semibold">
          <span>9:41</span>
          <span class="flex items-center gap-1" aria-hidden="true">
            <svg width="14" height="10" viewBox="0 0 14 10" fill="currentColor">
              <rect x="0" y="6" width="2.5" height="4" rx="0.5"></rect>
              <rect x="3.5" y="4" width="2.5" height="6" rx="0.5"></rect>
              <rect x="7" y="2" width="2.5" height="8" rx="0.5"></rect>
              <rect x="10.5" y="0" width="2.5" height="10" rx="0.5"></rect>
            </svg>
            <svg width="22" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor">
              <rect x="0.5" y="0.5" width="18" height="9" rx="2.5"></rect>
              <rect x="2" y="2" width="13" height="6" rx="1" fill="currentColor" stroke="none"
              ></rect>
              <path d="M20 3.5v3" stroke-width="1.5"></path>
            </svg>
          </span>
        </div>

        <div class="mt-8 flex items-center justify-center gap-1.5">
          <Logo variant="mark" height={16} />
          <span class="text-xs font-semibold tracking-tight">Identizen</span>
        </div>

        <p
          class="mt-6 text-center font-mono text-[0.6rem] uppercase tracking-[0.14em] text-fg-muted"
        >
          Sign-in request
        </p>
        <div class="mt-2 flex items-center justify-center gap-2">
          <span
            class="inline-block h-5 w-5 rounded bg-fg"
            style="clip-path: polygon(0 0, 100% 0, 100% 65%, 65% 100%, 0 100%)"></span>
          <span class="text-base font-semibold tracking-tight">Acme</span>
        </div>
        <p class="mt-0.5 text-center font-mono text-2xs text-fg-muted">acme.com</p>

        <div class="mt-5 rounded-2xl border border-border bg-surface-1 px-4 py-4 text-center">
          <p class="text-2xs text-fg-muted">Match code</p>
          <p class="tabular mt-1 font-mono text-4xl font-semibold tracking-tight">{CODE}</p>
          <p class="mt-1 text-2xs text-fg-muted">Same as on your screen?</p>
        </div>

        <div class="mt-auto">
          <div class="mb-3 flex justify-center text-accent">
            <span class="relative inline-flex">
              <span
                class="animate-pulse-ring absolute inset-0 rounded-full bg-accent-soft"
                aria-hidden="true"></span>
              <span
                class="relative inline-flex h-12 w-12 items-center justify-center rounded-full bg-accent-soft"
              >
                <FaceId size={28} />
              </span>
            </span>
          </div>
          <div
            class="flex h-10 items-center justify-center gap-2 rounded-xl bg-accent text-sm font-medium text-accent-fg shadow-sm"
          >
            <Icon name="check" size={15} />
            Approve with Face ID
          </div>
          <div class="mt-1 flex h-9 items-center justify-center text-sm text-fg-muted">Deny</div>
          <div class="mx-auto mt-2 h-1 w-24 rounded-full bg-fg/80"></div>
        </div>
      </div>
    </PhoneMock>
  </div>
</div>
