---
import { FOOTER, SITE } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface-1">
  <div class="container-prose grid gap-10 py-12 sm:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div class="max-w-xs">
      <p class="font-semibold">{SITE.name}</p>
      <p class="mt-2 text-sm text-fg-muted">
        Open-source, device-based identity. Standard OIDC on the outside, your phone on the inside.
      </p>
      <p class="mt-4 text-xs text-fg-muted">Apache-2.0 · One monorepo · No password database</p>
    </div>
    {
      FOOTER.map((group) => (
        <nav aria-label={group.heading}>
          <p class="text-2xs font-medium uppercase tracking-wide text-fg-muted">{group.heading}</p>
          <ul class="mt-3 space-y-2">
            {group.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-fg-muted hover:text-fg"
                  rel={item.external ? 'noopener' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="border-t border-border">
    <div
      class="container-prose flex flex-wrap items-center justify-between gap-2 py-5 text-xs text-fg-muted"
    >
      <span>© {year} Identizen. Built in the open.</span>
      <span class="font-mono">index.identizen.com · app.identizen.com · docs.identizen.com</span>
    </div>
  </div>
</footer>
