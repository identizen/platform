---
import { FOOTER, SITE } from '../lib/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
const hosts = [
  { host: 'index.identizen.com', what: 'index' },
  { host: 'app.identizen.com', what: 'dashboard' },
  { host: 'docs.identizen.com', what: 'docs' },
  { host: 'jtmerlin.com', what: 'demo bank' },
];
---

<footer class="border-t border-border bg-surface-1">
  <div class="container-site py-14">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
      <div class="max-w-xs">
        <a
          href="/"
          class="inline-flex items-center text-fg"
          aria-label="Identizen, back to the top"
        >
          <Logo height={20} />
        </a>
        <p class="mt-3 text-sm leading-relaxed text-fg-muted">
          Accountless identity, open core. Your phone holds the identity, your biometric unlocks it,
          and your app receives standard OIDC.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href="/download" class="btn btn-secondary btn-sm">Get the app</a>
          <a href={`${SITE.docs}/quickstart`} class="btn btn-secondary btn-sm" rel="noopener">
            Quickstart
          </a>
        </div>
      </div>
      {
        FOOTER.map((group) => (
          <nav aria-label={group.heading}>
            <p class="eyebrow">{group.heading}</p>
            <ul class="mt-4 space-y-2.5">
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-sm text-fg-muted transition-colors hover:text-fg"
                    rel={item.external ? 'noopener' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>
  <div class="border-t border-border">
    <div
      class="container-site flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-5 text-xs text-fg-muted"
    >
      <span>© {year} Identizen. Open core: protocol, index, SDKs and apps under Apache-2.0.</span>
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-1" aria-label="Live services">
        {
          hosts.map((h) => (
            <li class="flex items-center gap-1.5 font-mono">
              <span class="h-1.5 w-1.5 rounded-full bg-success" aria-hidden="true" />
              <a href={`https://${h.host}`} class="text-fg hover:text-accent" rel="noopener">
                {h.host}
              </a>
              <span class="hidden sm:inline">{h.what}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
