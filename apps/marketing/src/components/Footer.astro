---
import { FOOTER, SITE } from '../lib/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
const hosts = [
  { host: 'index.identizen.com', what: 'index · OIDC' },
  { host: 'app.identizen.com', what: 'dashboard' },
  { host: 'docs.identizen.com', what: 'docs' },
];
---

<footer class="border-t border-border bg-surface-1">
  <div class="container-site grid gap-10 py-14 md:grid-cols-[1.6fr_1fr_1fr_1fr]">
    <div class="max-w-sm">
      <a href="/" class="inline-flex items-center text-fg" aria-label="Identizen, back to the top">
        <Logo height={20} />
      </a>
      <p class="mt-3 text-sm leading-relaxed text-fg-muted">
        Open-source, device-based identity. Standard OIDC on the outside, your phone on the inside.
      </p>
      <ul class="mt-5 space-y-1.5">
        {
          hosts.map((h) => (
            <li class="flex items-center gap-2 py-1 font-mono text-xs">
              <span class="h-1.5 w-1.5 rounded-full bg-success" aria-hidden="true" />
              <a
                href={`https://${h.host}`}
                class="inline-flex min-h-6 items-center text-fg hover:text-accent"
                rel="noopener"
              >
                {h.host}
              </a>
              <span class="text-fg-muted">{h.what}</span>
            </li>
          ))
        }
      </ul>
    </div>
    {
      FOOTER.map((group) => (
        <nav aria-label={group.heading}>
          <p class="eyebrow">{group.heading}</p>
          <ul class="mt-4 space-y-2.5">
            {group.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-fg-muted transition-colors hover:text-fg"
                  rel={item.external ? 'noopener' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="border-t border-border">
    <div
      class="container-site flex flex-wrap items-center justify-between gap-2 py-5 text-xs text-fg-muted"
    >
      <span>© {year} Identizen. Built in the open.</span>
      <span class="font-mono">Apache-2.0 · one monorepo · no password database</span>
    </div>
  </div>
</footer>
