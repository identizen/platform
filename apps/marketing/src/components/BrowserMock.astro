---
import Icon from './Icon.astro';

/** A browser window card: traffic lights, address bar, slotted page. */
interface Props {
  url?: string;
  class?: string;
}
const { url = 'acme.com/login', class: className } = Astro.props;
---

<div class:list={['browser card-gradient overflow-hidden', className]}>
  <div
    class="flex items-center gap-3 border-b border-border bg-surface-1/80 px-3 py-2"
    aria-hidden="true"
  >
    <span class="chrome-dots"><i></i><i></i><i></i></span>
    <span
      class="flex h-7 flex-1 items-center gap-2 rounded-md bg-surface-0 px-3 font-mono text-2xs text-fg-muted shadow-xs ring-1 ring-border"
    >
      <Icon name="lock" size={11} class="text-success" />
      <span class="truncate">{url}</span>
    </span>
    <span class="hidden h-7 w-7 rounded-md bg-surface-2 sm:block"></span>
  </div>
  <div class="browser-page relative bg-surface-0">
    <slot />
  </div>
</div>

<style>
  .browser {
    box-shadow: var(--shadow-window);
  }
  .browser::before {
    z-index: 1;
  }
</style>
