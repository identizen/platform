{
  "name": "@identizen/db",
  "version": "0.5.0",
  "private": false,
  "description": "Identizen index schema (Drizzle), migrations, and the typed query module.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "schema.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/cli-migrate.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@identizen/protocol": "^0.2.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/plsft/identizen.git",
    "directory": "db"
  }
}
