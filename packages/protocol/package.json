{
  "name": "@identizen/protocol",
  "version": "0.1.0",
  "description": "Identizen protocol: keys, canonical encoding (JCS), challenge/assertion signing and verification, rotating BLE identifiers. The single implementation every Identizen component imports.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/identizen/platform",
    "directory": "packages/protocol"
  },
  "homepage": "https://identizen.com",
  "keywords": [
    "identizen",
    "identity",
    "ed25519",
    "oidc",
    "passwordless",
    "mfa"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --coverage",
    "vectors": "tsx scripts/gen-vectors.ts"
  },
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "@scure/bip39": "^1.6.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
